# Port the relay server listens on
PORT=5000

# Set to `production` when hosting behind HTTPS so HSTS is advertised.
NODE_ENV=development

# Comma-separated allow-list of cross-origin browser hosts that may connect
# (e.g. http://localhost:5173,https://app.example.com).
# Empty (default) = same-origin only: the relay serves the built app itself,
# so cross-origin CORS is disabled and only browsers served from this host
# can connect. Requires the client to be proxied or hosted on this host.
ORIGIN=

# Optional alias for the same setting (ORIGIN wins if both are set).
# CORS_ORIGINS=

# Set to `true` ONLY when the relay sits behind a reverse proxy (nginx, caddy,
# Fly, Render...) so rate limiting and connection caps key on the real client
# IP instead of the proxy address.
TRUST_PROXY=false

# Folder containing the built frontend (defaults to ../dist)
STATIC_DIR=../dist